#!/bin/sh
# SPDX-License-Identifier: curl
# SPDX-FileCopyrightText: the blitzy-curl project contributors
#
# Baseline bootstrap entry point.                                        DL-0033
# Usage: baseline-bootstrap [staging-root] [-- command ...]
#
# Default staging root: $BASELINE_STAGE, else <repo>/target/baseline.
# Honours $AUTORECONF.                                                    DL-0033
#
# Compares the oracle against BASELINE.toml.                            DL-0220
# Never writes under the oracle root.                                      [R1]
#
# $CURL_CI_REPORTING selects off or isolated; default off.              DL-0282
# Off clears every provider variable.                                   DL-0282

set -eu
unset CDPATH

staging_argument=""
run_command=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --)
      shift
      run_command=1
      break
      ;;
    *)
      if [ -z "$staging_argument" ]; then
        staging_argument="$1"
      fi
      shift
      ;;
  esac
done

script_directory=$(cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(cd -- "$script_directory/../.." && pwd)
oracle="$repository_root/original"
record="$repository_root/BASELINE.toml"
staging="${staging_argument:-${BASELINE_STAGE:-$repository_root/target/baseline}}"

# Variables the vendored harness reports results through.              DL-0282
provider_variables="AZURE_ACCESS_TOKEN AGENT_JOBNAME BUILD_BUILDID"
provider_variables="$provider_variables SYSTEM_TEAMFOUNDATIONCOLLECTIONURI"
provider_variables="$provider_variables SYSTEM_TEAMPROJECTID APPVEYOR_API_URL"

# Accepted isolated-mode values, per variable.                         DL-0282
# A token has no accepted value.                                       DL-0282
provider_value_accepted() {
  case "$1" in
    SYSTEM_TEAMFOUNDATIONCOLLECTIONURI | APPVEYOR_API_URL)
      case "$2" in
        http://127.0.0.1:*) return 0 ;;
        *) return 1 ;;
      esac
      ;;
    BUILD_BUILDID | SYSTEM_TEAMPROJECTID)
      case "$2" in
        '' | *[!0-9]*) return 1 ;;
        *) return 0 ;;
      esac
      ;;
    AGENT_JOBNAME)
      case "$2" in
        '' | *[!A-Za-z0-9._-]*) return 1 ;;
        *) return 0 ;;
      esac
      ;;
    *) return 1 ;;
  esac
}

case "${CURL_CI_REPORTING:-off}" in
  off)
    provider_cleared=0
    for provider_name in $provider_variables; do
      if eval "[ \"\${$provider_name+set}\" = set ]"; then
        unset "$provider_name"
        provider_cleared=$((provider_cleared + 1))
      fi
    done
    echo "baseline-bootstrap: provider reporting off," \
      "$provider_cleared variable(s) cleared"
    ;;
  isolated)
    for provider_name in $provider_variables; do
      eval "provider_value=\${$provider_name-}"
      if [ -n "$provider_value" ] &&
        ! provider_value_accepted "$provider_name" "$provider_value"; then
        echo "baseline-bootstrap: $provider_name value not accepted" >&2
        exit 1
      fi
    done
    echo "baseline-bootstrap: provider reporting isolated, values accepted"
    ;;
  *)
    echo "baseline-bootstrap: CURL_CI_REPORTING is off or isolated" >&2
    exit 1
    ;;
esac

# The oracle is read-only.                                               [R1]
if [ ! -f "$oracle/configure.ac" ]; then
  echo "baseline-bootstrap: no oracle at $oracle" >&2
  exit 1
fi

if [ ! -f "$record" ]; then
  echo "baseline-bootstrap: no frozen record at $record" >&2
  exit 1
fi

# Staging root: never the oracle, never outside the checkout.            DL-0033
case "$staging" in
  "$oracle" | "$oracle"/*)
    echo "baseline-bootstrap: staging root inside the oracle: $staging" >&2
    exit 1
    ;;
  "$repository_root"/*) ;;
  *)
    echo "baseline-bootstrap: staging root outside $repository_root: $staging" >&2
    exit 1
    ;;
esac

# Frozen value of one key of a BASELINE.toml section.                   DL-0220
frozen() {
  awk -v section="[$1]" -v key="$2" '
    $0 == section { inside = 1; next }
    /^\[/ { inside = 0 }
    inside && $1 == key { print $3; exit }
  ' "$record" | tr -d '"'
}

# Mode and content of every oracle file, one digest.                    DL-0221
# One line per file: mode, content digest, path.                        DL-0221
oracle_digest() {
  (
    cd -- "$repository_root" || exit 1
    find original -type f | LC_ALL=C sort | while IFS= read -r path; do
      if [ -x "$path" ]; then
        mode=100755
      else
        mode=100644
      fi
      printf '%s %s %s\n' "$mode" "$(sha256sum <"$path" | cut -d' ' -f1)" "$path"
    done | sha256sum | cut -d' ' -f1
  )
}

oracle_files() {
  find "$oracle" -type f | wc -l | tr -d ' '
}

oracle_executables() {
  find "$oracle" -type f -perm -u+x | wc -l | tr -d ' '
}

oracle_symlinks() {
  find "$oracle" -type l | wc -l | tr -d ' '
}

frozen_digest=$(frozen worktree digest)
frozen_files=$(frozen worktree files)
frozen_executables=$(frozen worktree executable-files)
frozen_tag=$(frozen tag name)

if [ -z "$frozen_digest" ] || [ -z "$frozen_files" ] || [ -z "$frozen_tag" ]; then
  echo "baseline-bootstrap: $record records no frozen worktree state" >&2
  exit 1
fi

# Untracked or modified oracle content is rejected.                       [R1]
if command -v git >/dev/null 2>&1 &&
  git -C "$repository_root" rev-parse --git-dir >/dev/null 2>&1; then
  dirt=$(git -C "$repository_root" status --porcelain -- original | wc -l | tr -d ' ')
  if [ "$dirt" != "0" ]; then
    echo "baseline-bootstrap: the oracle worktree is not clean" >&2
    git -C "$repository_root" status --porcelain -- original >&2
    exit 1
  fi
  tracked=$(git -C "$repository_root" ls-files original | wc -l | tr -d ' ')
  if [ "$tracked" != "$frozen_files" ]; then
    echo "baseline-bootstrap: $tracked tracked oracle file(s), $frozen_files recorded" >&2
    exit 1
  fi
fi

# Compared against the frozen record, never against itself.            DL-0220
verify_oracle() {
  stage="$1"
  digest=$(oracle_digest)
  files=$(oracle_files)
  executables=$(oracle_executables)
  symlinks=$(oracle_symlinks)
  if [ "$digest" != "$frozen_digest" ] ||
    [ "$files" != "$frozen_files" ] ||
    [ "$executables" != "$frozen_executables" ] ||
    [ "$symlinks" != "0" ]; then
    echo "baseline-bootstrap: the oracle does not match $record ($stage)" >&2
    echo "  measured: $digest ($files files, $executables executable, $symlinks symlink)" >&2
    echo "  recorded: $frozen_digest ($frozen_files files, $frozen_executables executable, 0 symlink)" >&2
    exit 1
  fi
}

verify_oracle "before staging"

# A copy out of the oracle, never into it.                               DL-0033
rm -rf -- "$staging"
mkdir -p -- "$staging"
cp -a -- "$oracle/." "$staging/"

( cd -- "$staging" && exec ${AUTORECONF:-autoreconf} -fi )

if [ ! -x "$staging/configure" ]; then
  echo "baseline-bootstrap: no configure in $staging" >&2
  exit 1
fi

verify_oracle "after staging"

echo "baseline-bootstrap: oracle matches $frozen_tag record, digest $frozen_digest, $frozen_files files"
echo "$staging"

# A trailing command runs in the environment settled above.            DL-0282
if [ "$run_command" = "1" ] && [ "$#" -gt 0 ]; then
  exec "$@"
fi
